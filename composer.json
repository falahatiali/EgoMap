{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-intl": "*",
        "dompdf/dompdf": "^3.1",
        "khaled.alshamaa/ar-php": "^6.3",
        "laravel/ai": "^0.7.0",
        "laravel/cashier": "^16.5",
        "laravel/framework": "^13.8",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.3",
        "mischasigtermans/laravel-toon": "^1.1",
        "nwidart/laravel-modules": "^13.0",
        "spatie/laravel-pdf": "^2.9",
        "spatie/laravel-permission": "^7.4",
        "spatie/laravel-translatable": "^6.14"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\MissionEngine\\": "Modules/MissionEngine/",
            "Modules\\MissionEngine\\Database\\Factories\\": "Modules/MissionEngine/database/factories/",
            "Modules\\MissionEngine\\Database\\Seeders\\": "Modules/MissionEngine/database/seeders/",
            "Modules\\GamificationEngine\\": "Modules/GamificationEngine/",
            "Modules\\GamificationEngine\\Database\\Factories\\": "Modules/GamificationEngine/database/factories/",
            "Modules\\GamificationEngine\\Database\\Seeders\\": "Modules/GamificationEngine/database/seeders/",
            "Modules\\AetherEngine\\": "Modules/AetherEngine/",
            "Modules\\AetherEngine\\Database\\Factories\\": "Modules/AetherEngine/database/factories/",
            "Modules\\AetherEngine\\Database\\Seeders\\": "Modules/AetherEngine/database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Modules\\MissionEngine\\Tests\\": "Modules/MissionEngine/tests/",
            "Modules\\GamificationEngine\\Tests\\": "Modules/GamificationEngine/tests/",
            "Modules\\AetherEngine\\Tests\\": "Modules/AetherEngine/tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
